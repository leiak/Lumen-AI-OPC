<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.opc.notification.mapper.NotificationSmsLogMapper">

    <resultMap id="BaseResultMap" type="com.ruoyi.opc.notification.domain.NotificationSmsLog">
        <id property="id" column="id" />
        <result property="phone" column="phone" />
        <result property="templateCode" column="template_code" />
        <result property="varsJson" column="vars_json" />
        <result property="content" column="content" />
        <result property="status" column="status" />
        <result property="retryCount" column="retry_count" />
        <result property="errorMsg" column="error_msg" />
        <result property="provider" column="provider" />
        <result property="sentAt" column="sent_at" />
        <result property="createdAt" column="created_at" />
        <result property="createBy" column="create_by" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id, phone, template_code, vars_json, content, status, retry_count, error_msg, provider,
        sent_at, created_at, create_by, update_by, update_time
    </sql>

    <insert id="insert" parameterType="com.ruoyi.opc.notification.domain.NotificationSmsLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO opc_notification_sms_log (
            phone, template_code, vars_json, content, status, retry_count, error_msg, provider,
            sent_at, created_at, create_by, update_by, update_time
        ) VALUES (
            #{phone}, #{templateCode}, #{varsJson}, #{content}, #{status}, #{retryCount}, #{errorMsg}, #{provider},
            #{sentAt}, #{createdAt}, #{createBy}, #{updateBy}, #{updateTime}
        )
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM opc_notification_sms_log
        WHERE id = #{id}
    </select>

    <update id="updateById" parameterType="com.ruoyi.opc.notification.domain.NotificationSmsLog">
        UPDATE opc_notification_sms_log
        <set>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="templateCode != null and templateCode != ''">template_code = #{templateCode},</if>
            <if test="varsJson != null">vars_json = #{varsJson},</if>
            <if test="content != null">content = #{content},</if>
            <if test="status != null">status = #{status},</if>
            <if test="retryCount != null">retry_count = #{retryCount},</if>
            <if test="errorMsg != null">error_msg = #{errorMsg},</if>
            <if test="provider != null and provider != ''">provider = #{provider},</if>
            <if test="sentAt != null">sent_at = #{sentAt},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM opc_notification_sms_log WHERE id = #{id}
    </delete>

    <select id="selectList" resultMap="BaseResultMap" parameterType="com.ruoyi.opc.notification.domain.NotificationSmsLog">
        SELECT <include refid="Base_Column_List" />
        FROM opc_notification_sms_log
        <where>
            <if test="phone != null and phone != ''">AND phone = #{phone}</if>
            <if test="templateCode != null and templateCode != ''">AND template_code = #{templateCode}</if>
            <if test="status != null">AND status = #{status}</if>
            <if test="provider != null and provider != ''">AND provider = #{provider}</if>
        </where>
        ORDER BY created_at DESC
    </select>

</mapper>
