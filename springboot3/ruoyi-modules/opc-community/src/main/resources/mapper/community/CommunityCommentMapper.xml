<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.opc.community.mapper.CommunityCommentMapper">

    <resultMap id="BaseResultMap" type="com.ruoyi.opc.community.domain.CommunityComment">
        <id     column="id"         property="id"/>
        <result column="module_id"  property="moduleId"/>
        <result column="user_id"    property="userId"/>
        <result column="user_name"  property="userName"/>
        <result column="content"    property="content"/>
        <result column="parent_id"  property="parentId"/>
        <result column="status"     property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="BaseColumns">
        id, module_id, user_id, user_name, content, parent_id, status, create_time
    </sql>

    <insert id="insert" parameterType="com.ruoyi.opc.community.domain.CommunityComment"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO opc_community_comment
        (module_id, user_id, user_name, content, parent_id, status, create_time)
        VALUES
        (#{moduleId}, #{userId}, #{userName}, #{content},
         <choose>
             <when test="parentId != null">#{parentId}</when>
             <otherwise>0</otherwise>
         </choose>,
         'PUBLISHED', NOW())
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM opc_community_comment WHERE id = #{id}
    </select>

    <select id="selectByModuleId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM opc_community_comment
        WHERE module_id = #{moduleId} AND status = 'PUBLISHED'
        ORDER BY create_time DESC
        LIMIT 200
    </select>

    <select id="countByModuleId" resultType="int">
        SELECT COUNT(*) FROM opc_community_comment
        WHERE module_id = #{moduleId} AND status = 'PUBLISHED'
    </select>

    <delete id="deleteById">
        UPDATE opc_community_comment SET status = 'DELETED' WHERE id = #{id}
    </delete>
</mapper>
