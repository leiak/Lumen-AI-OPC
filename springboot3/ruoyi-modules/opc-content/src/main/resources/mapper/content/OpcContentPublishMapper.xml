        <result property="scriptId" column="script_id" />
        <result property="platformAccountId" column="platform_account_id" />
        <result property="platform" column="platform" />
        <result property="title" column="title" />
        <result property="tags" column="tags" />
        <result property="externalVideoId" column="external_video_id" />
        <result property="externalPostId" column="external_post_id" />
        <result property="externalUrl" column="external_url" />
        <result property="status" column="status" />
        <result property="errorCode" column="error_code" />
        <result property="errorMessage" column="error_message" />
        <result property="publishedAt" column="published_at" />
        <result property="updatedAt" column="updated_at" />
        <result property="createdAt" column="created_at" />
