<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.opc.erp.mapper.OpcErpDailySnapshotMapper">

    <sql id="BaseColumns">
        id, company_id, snapshot_date, sku_id, opening_stock, in_qty, out_qty,
        closing_stock, create_time
    </sql>

    <insert id="insert" parameterType="com.ruoyi.opc.erp.domain.OpcErpDailySnapshot">
        INSERT INTO opc_erp_daily_snapshot (
            <include refid="BaseColumns"/>
        )
        VALUES (
            #{id}, #{companyId}, #{snapshotDate}, #{skuId},
            #{openingStock}, #{inQty}, #{outQty}, #{closingStock},
            NOW()
        )
    </insert>

    <select id="selectByCompanyAndDate" resultType="com.ruoyi.opc.erp.domain.OpcErpDailySnapshot">
        SELECT <include refid="BaseColumns"/>
        FROM opc_erp_daily_snapshot
        WHERE company_id = #{companyId}
          AND snapshot_date = #{date}
        ORDER BY sku_id ASC
    </select>

    <select id="selectByCompanyAndDateRange" resultType="com.ruoyi.opc.erp.domain.OpcErpDailySnapshot">
        SELECT <include refid="BaseColumns"/>
        FROM opc_erp_daily_snapshot
        WHERE company_id = #{companyId}
          AND snapshot_date &gt;= #{startDate}
          AND snapshot_date &lt;= #{endDate}
        ORDER BY snapshot_date ASC, sku_id ASC
    </select>

</mapper>
