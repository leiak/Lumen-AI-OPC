# aiopc-frontend
# Stage 1: build Vue SPA (npm install + vite build)
# Stage 2: serve static dist/ + reverse-proxy /prod-api/* via nginx
FROM node:20-alpine AS builder

LABEL maintainer="aiopc"

WORKDIR /build

# Copy package files first for layer caching
COPY ./package.json ./
COPY ./package-lock.json* ./
COPY ./.npmrc* ./

RUN npm install --prefer-offline --no-audit --no-fund --registry=https://registry.npmmirror.com

# Copy source + build
COPY ./ ./
RUN npm run build:prod

# Stage 2: nginx serves static + reverse-proxies API
FROM nginx:1.27-alpine

# Replace default nginx config with our reverse-proxy config
COPY ./nginx.conf /etc/nginx/conf.d/default.conf

# Copy built SPA from builder stage
COPY --from=builder /build/dist/ /usr/share/nginx/html/

EXPOSE 8079

CMD ["nginx", "-g", "daemon off;"]