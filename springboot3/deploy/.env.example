# OPC docker stack 环境变量模板 (W48.6)
# 用法: cp .env.example .env, 然后填真值。docker-compose 自动读 .env。

# ====== LLM Provider API Keys (W48.6: DeepSeek + MiniMax 双主力) ======
# DeepSeek: https://platform.deepseek.com/api_keys  (OpenAI 兼容, base_url=https://api.deepseek.com/v1)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# MiniMax (MiniMaxAI): https://api.minimaxi.com  (OpenAI 兼容, base_url=https://api.minimaxi.com/v1)
# API key 一般以 eyJ 开头 (JWT)
MINIMAX_API_KEY=ey-your-minimax-key-here

# OpenAI 备用 (默认 disabled, 不配也行)
# OPENAI_API_KEY=sk-your-openai-key-here
