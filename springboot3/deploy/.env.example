# ============================================================
# AIOPC 全栈环境变量示例 (W79 部署)
#
# 用法:
#   cp .env.example .env       # 复制为 .env (git ignored)
#   vim .env                   # 填真值
#
# W79 Remote SSH 部署:
#   - VM 必须 root 跑
#   - 本机 Windows 用 backup-mysql-local.sh 导出,scp 到 VM
#   - VM 上跑 bootstrap-remote.sh,会读取 /opt/aiopc/springboot3/deploy/.env
#
# 必填项:
#   - DEEPSEEK_API_KEY + MINIMAX_API_KEY (留空则 AI 接口 401,其他功能正常)
#   - MYSQL_ROOT_PASSWORD (MySQL root 密码)
#   - COMPOSE_MYSQL_PWD (与上面保持一致,compose 内部用)
# ============================================================

# ====== LLM Provider API Keys (W48.6: DeepSeek + MiniMax 双主力) ======

# DeepSeek API key (https://platform.deepseek.com)
# 留空 placeholder 时: ai-core 服务的 /v1/chat/completions 返回 401
# 不影响: 业务容器正常启动,登录、网关、Nacos、其他 12 个服务全 UP
DEEPSEEK_API_KEY=

# MiniMax (MiniMaxAI) API key (https://api.minimaxi.com)
# 留空 placeholder 时: 同上,只有 LLM 调用 401
MINIMAX_API_KEY=

# OpenAI 备用 (默认 disabled, 不配也行)
# OPENAI_API_KEY=sk-your-openai-key-here

# ====== MySQL (W79 bootstrap 必填) ======

# MySQL root 密码 — 必须与 COMPOSE_MYSQL_PWD 保持一致
# VM 首次 bootstrap 时 aiopc-mysql initdb 用此密码建库
MYSQL_ROOT_PASSWORD=Opc@2026!
COMPOSE_MYSQL_PWD=Opc@2026!

# ============================================================
# W79 Rocky 8.10 VM Bootstrap (可选)
# ============================================================
# 这些变量 bootstrap-remote.sh 会读取,缺省有合理默认
#
# DATA_ROOT=/opt/aiopc-data
#   容器 bind mount 根目录 + stage marker 文件位置
#   rm ${DATA_ROOT}/.bootstrap-stages-ok.4  # 强制重跑 stage 4
#
# STAGING=/tmp/aiopc-staging
#   aiopc-migrate-*.tar.gz 解压目录
#
# OPC_TABLE_SKIP_MIN=10
#   stage 5 smoke test 3 期望的 opc_* 表数下限
#   留 0 可跳过检查(用于 --from 5 跳 stage 4 验证)
#
# REPO_URL=https://github.com/leiak/Lumen-AI-OPC.git
# REPO_BRANCH=main
#   stage 2 git clone 用,缺省 main
