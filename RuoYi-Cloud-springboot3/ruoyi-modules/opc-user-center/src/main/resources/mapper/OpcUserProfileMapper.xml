<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.opc.user.mapper.OpcUserProfileMapper">

    <resultMap id="BaseResultMap" type="com.ruoyi.opc.user.domain.OpcUserProfile">
        <id property="id" column="id" />
        <result property="userId" column="user_id" />
        <result property="userType" column="user_type" />
        <result property="realName" column="real_name" />
        <result property="idCardNo" column="id_card_no" />
        <result property="mobile" column="mobile" />
        <result property="avatarUrl" column="avatar_url" />
        <result property="bio" column="bio" />
        <result property="industry" column="industry" />
        <result property="city" column="city" />
        <result property="invitationCode" column="invitation_code" />
        <result property="inviterId" column="inviter_id" />
        <result property="verified" column="verified" />
        <result property="verifiedTime" column="verified_time" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="Base_Columns">
        id, user_id, user_type, real_name, id_card_no, mobile, avatar_url, bio,
        industry, city, invitation_code, inviter_id, verified, verified_time,
        status, create_by, create_time, update_by, update_time, remark
    </sql>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns" />
        FROM opc_user_profile WHERE user_id = #{userId}
    </select>

    <select id="selectByInvitationCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns" />
        FROM opc_user_profile WHERE invitation_code = #{code}
    </select>

    <insert id="insert" parameterType="com.ruoyi.opc.user.domain.OpcUserProfile" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO opc_user_profile (
            user_id, user_type, real_name, mobile, avatar_url, bio, industry, city,
            invitation_code, inviter_id, verified, status,
            create_by, create_time
        ) VALUES (
            #{userId}, #{userType}, #{realName}, #{mobile}, #{avatarUrl}, #{bio}, #{industry}, #{city},
            #{invitationCode}, #{inviterId}, #{verified}, #{status},
            #{createBy}, NOW()
        )
    </insert>

    <update id="update" parameterType="com.ruoyi.opc.user.domain.OpcUserProfile">
        UPDATE opc_user_profile
        <set>
            <if test="userType != null">user_type = #{userType},</if>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="mobile != null">mobile = #{mobile},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
            <if test="bio != null">bio = #{bio},</if>
            <if test="industry != null">industry = #{industry},</if>
            <if test="city != null">city = #{city},</if>
            <if test="verified != null">verified = #{verified},</if>
            <if test="status != null">status = #{status},</if>
            update_by = #{updateBy},
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

</mapper>
