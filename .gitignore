# ===== Secrets / local config =====
.env
.env.*
!.env.example
# 构建配置,不含密钥,必须入库:缺了 VITE_APP_BASE_API 会变 undefined,
# 前端退回裸路径调接口,又和 SPA 页面路由撞名(刷新 /opc/**、/system/** 白屏)
!vue3-typescript/.env.production
!vue3-typescript/.env.development
*.pem
*.key
credentials*
secrets.*

# ===== Temp =====
*.tmp
*.bak
*.swp
*~

# ===== Coverage / test output =====
coverage/
.nyc_output/
*.lcov
test-output/
surefire-reports/

# ===== OPC deploy runtime data (W48.7 固化) =====
# MySQL/Redis/Qdrant/MinIO/ES 用 host bind mount, 数据在 repo 外持久化
springboot3/deploy/mysql/data/
springboot3/deploy/redis/data/
springboot3/deploy/qdrant/data/
springboot3/deploy/minio/data/
springboot3/deploy/es/data/
# MySQL 备份文件, 二进制不进 repo (需要长期保留请 cp 到网盘/Git LFS)
springboot3/deploy/backups/
# ===== Python (tmp_e2e/ 等验证脚本) =====
# py_compile 会在脚本旁生成 __pycache__,别混进提交
__pycache__/
*.py[cod]
