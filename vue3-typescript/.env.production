# 生产环境接口前缀
#
# nginx 只把 /prod-api/ 反代给 gateway(见 vue3-typescript/nginx.conf),
# 其余路径一律交回 SPA。这条前缀是必需的:不加的话 axios 会用裸路径
# /opc/**、/system/**、/auth/** 调后端,而这些路径同时又是 SPA 页面路由
# (src/router),两者在 nginx 里无法区分 —— 浏览器刷新 /opc/community/market
# 时那个 GET 导航请求会被当成接口转给 gateway,页面直接白屏。
#
# nginx 的 proxy_pass 带尾斜杠,会把 /prod-api/ 整段剥掉再转发,
# 所以 gateway 收到的路径与加前缀前完全一致(已实测 /code、/system/**、
# /opc/** 三组响应逐一比对一致),不需要改网关任何路由。
VITE_APP_BASE_API = /prod-api