{
  "public": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/**", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "**/*.@(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "proxies": [
    {
      "source": "/prod-api",
      "target": "http://aiopc-gateway:8080",
      "changeOrigin": true,
      "secure": false
    }
  ]
}
